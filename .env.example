# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./backend/database.sqlite

# Email Configuration
# Choose ONE option: SendGrid (recommended for Render.com) OR SMTP (Gmail, etc.)

# OPTION 1: SendGrid (Recommended for Render.com, Vercel, etc.)
# Get free API key at: https://signup.sendgrid.com (100 emails/day free)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=Event Registration <your-verified-email@gmail.com>

# OPTION 2: Traditional SMTP (Gmail, Outlook, etc.)
# Note: May not work on some hosting platforms (Render free tier blocks SMTP)
# For Gmail: Use app password from https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=Event Registration <your-email@gmail.com>

# Event Configuration
EVENT_NAME=My Awesome Event
EVENT_DATE=2025-12-31T19:00:00
EVENT_LOCATION=Event Venue Address
EVENT_DESCRIPTION=Join us for an amazing event!

# Application URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Admin Configuration
ADMIN_PASSWORD=change-this-secure-password

# Apple Wallet Configuration (Optional - for production)
# APPLE_PASS_TYPE_ID=pass.com.yourcompany.event
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_CERTIFICATE_PATH=./certificates/pass.p12
# APPLE_CERTIFICATE_PASSWORD=your-certificate-password

# Google Wallet Configuration (Optional - for production)
# GOOGLE_ISSUER_ID=your-issuer-id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_PATH=./certificates/google-service-account.json
